{
  "name": "Invariant-Based Documentation Generator",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-vscode.extension-test-runner",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "npm install && pip install hypothesis"
}
